# ── CBA (Code Base Assistant) configuration ────────────────────────────────
# Everything the daemon needs. Edit here, then `./cbactl.sh restart`.

# Telegram bot (owns getUpdates polling — only ONE poller allowed per bot)
CBA_TOKEN=

# Founder's channel/chat. CBA always answers here and in any private chat.
CBA_MAIN_CHAT=

# Restrict who CBA answers. Comma-separated chat IDs. Empty =
# (fine for a private team bot; set IDs to lock it down on a public server).
CBA_ALLOWED_CHATS=

# Repos CBA can read (space-separated). First one is the working directory.
CBA_REPOS=

# Claude model alias: sonnet (fast, default), opus (deepest), haiku (cheapest)
CBA_MODEL=claude-opus-5-5

# Tools Claude may use. READ-ONLY by design — do NOT add Edit/Write/Bash unless
# you accept that anyone who can message the bot can run those on the server.
CBA_ALLOWED_TOOLS=

# Per-question timeout (seconds) before CBA gives up and replies with an error.
# Raised to 600s to allow larger document/Postman-generation requests to finish.
CBA_TIMEOUT=300

# CBA home (this directory). Auto-detected if left blank.
CBA_HOME=

# ── Email delivery (optional) ───────────────────────────────────────────────
# When a document is generated, CBA offers to email it. Fill these to enable.
# Gmail example: HOST=
#   PASS=
# Sourced from Vault (dev/data/all-config -> email-config), same account the BE
# notification engine sends from.
CBA_SMTP_HOST=
CBA_SMTP_PORT=
CBA_SMTP_USER=
CBA_SMTP_PASS=
CBA_SMTP_FROM=

# If someone says "mail me X" without giving an address, CBA sends here.
CBA_DEFAULT_EMAIL=

# ── Live data (read-only) ───────────────────────────────────────────────────
# Lets CBA answer real-data questions via db_tool.py (Mongo find / MySQL SELECT
# only, row-capped, no writes). Leave blank to keep CBA code-only.
CBA_DB_ENABLED=false
CBA_MONGO_URI=
CBA_MONGO_DB=
CBA_MYSQL_HOST=
CBA_MYSQL_PORT=
CBA_MYSQL_USER=
CBA_MYSQL_PASS=
CBA_MYSQL_DB=

# ── Actions / write access (per instance) ───────────────────────────────────
# true  → this bot may perform allow-listed actions (e.g. re-run a transaction).
# false → read-only. Keep FALSE for the dev CBA channel; TRUE only for the
# trusted "31st Deadline" channel. Every action is written to state/actions.log.
CBA_WRITE_ENABLED=false

